{
    "compilerOptions": {
        /* Basic Options */
        "moduleResolution": "NodeNext",
        "target": "es2019", /* ES2019 so tsc down-compiles ?. / ?? etc. to run on Node 12 (Windows 7 build) as well as modern Node. */
        "lib": ["es2022"], /* type-check against newer built-ins (deps' .d.ts reference them); does NOT change the es2019 emit. */
        "module": "NodeNext", /* Specify module code generation: 'none', 'commonjs', 'amd', 'system', 'umd', 'es2015', or 'ESNext'. */
        "outDir": "../dist",
        "rootDir": "./",
        "strict": true,
        "sourceMap": true /* Generates corresponding '.map' file. */
    }
}