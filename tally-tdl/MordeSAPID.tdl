;;=============================================================================
;;  Morde <-> Salesforce Connector : "SAP ID" field (per-object UDF)
;;-----------------------------------------------------------------------------
;;  Adds a "Morde SAP ID" field and ATTACHES it (Storage: MordeSAPID) to the
;;  Ledger, Stock Item and Voucher masters, so the value genuinely persists and
;;  can be read back / imported. (A bare [System: UDF] declaration alone did not
;;  persist on this build -- the Storage attachment below is the fix.)
;;
;;  SAFETY: additive only. Each master form gets ONE extra part/line/field via
;;  "Add:" -- nothing existing is removed, reordered or overridden. Removing this
;;  file later just hides the field; stored values stay in the data.
;;
;;  LOAD: F1 (Help) > TDL & Add-On > Manage Local TDLs > Load on startup = Yes >
;;        add this file's full path > Ctrl+A > restart TallyPrime.
;;        Do NOT also keep the earlier declaration-only version loaded (same UDF).
;;
;;  If TallyPrime reports an error on a specific Form/Part name (names can vary by
;;  version), tell us which line and we'll match it to your build.
;;=============================================================================

[System: UDF]
    MordeSAPID : String : 20001

;; ---------- shared input field ------------------------------------------------
[Field: Morde SAP ID Fld]
    Use      : Name Field
    Storage  : MordeSAPID
    Width    : 40
    Set as   : $MordeSAPID

;; ---------- Ledger (Account) --------------------------------------------------
[#Form: Ledger]
    Add : Parts : Morde SAP ID Part

[Part: Morde SAP ID Part]
    Lines        : Morde SAP ID Line
    Vertical     : Yes

[Line: Morde SAP ID Line]
    Fields       : Short Prompt, Morde SAP ID Fld
    Local        : Field : Short Prompt : Set as : "Morde SAP ID"

;; ---------- Stock Item (Product) ---------------------------------------------
[#Form: Stock Item]
    Add : Parts : Morde SAP ID Part

;; ---------- Voucher (Invoice / Purchase / Order / Note) ----------------------
;; Optional. If a voucher-screen error appears on load, delete this one block.
[#Form: Voucher]
    Add : Parts : Morde SAP ID Part
